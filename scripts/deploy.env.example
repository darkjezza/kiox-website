# Copy to deploy.env and fill in. Never commit deploy.env.
#
# Requires OpenSSH client on your PC (Windows optional feature / scp + ssh).

DEPLOY_HOST=192.168.0.131
DEPLOY_USER=Jezza
DEPLOY_PORT=22

# Optional: path to private key (otherwise ssh/scp use your default agent/key)
# DEPLOY_KEY=C:\Users\You\.ssh\id_ed25519

# Optional: SSH password (saved via: deploy-scp.ps1 -SavePassword). Prefer DEPLOY_KEY.
# DEPLOY_PASSWORD=

# --- Game server (Rust) — used when deploying from monorepo with -IncludeServer ---
SERVER_REMOTE_DIR=C:/kiox/server
SERVER_INSTANCE=live
SERVER_LISTEN_PORT=1227

# --- Website (Astro Node) ---
WEBSITE_REMOTE_DIR=C:/kiox/website
WEBSITE_LISTEN_PORT=4321
